# ============================================
# Docker Environment Configuration
# Copy this file to .env and update values
# ============================================

# SQL Server Configuration
SA_PASSWORD=YourStrong!Passw0rd123
MSSQL_PID=Express

# JWT Configuration
JWT_KEY=COONGCHAT_SUPER_SECRET_KEY_123456789_PRODUCTION
JWT_ISSUER=coongchat.api
JWT_AUDIENCE=coongchat.client
JWT_ACCESS_TOKEN_MINUTES=1440
JWT_REFRESH_TOKEN_DAYS=7

# Frontend Configuration
# For VPS deployment, change this to your domain/IP
# Example: http://your-domain.com:5053 or http://your-vps-ip:5053
NEXT_PUBLIC_API_URL=http://localhost:5053
